# Copy to .env and fill in. Never commit .env.
# Optional for the scripted demo (saved results are in app/var/cache/).
# Needed for anything new: on-demand Inspections of new images, the assistant panel, re-running the scoring.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# FOD_DECISION_MODEL=claude-haiku-5-5
# FOD_ESCALATION=off
# FOD_MAX_SPEND_USD=1.00
# FOD_AGENT=off            # always-on agent: off | code (never calls the model) | on. ./run-agent.sh sets on
# FOD_TIMELINE=timeline.json
